# 本文件可以提交。实际值由 scripts/initialize-local-env.ps1 写入被忽略的 .env。
VOICEANALYSIS_ENV=local
VOICEANALYSIS_API_KEY=__GENERATE_LOCAL_SECRET__
VOICEANALYSIS_AUTH_HEADER=X-Voice-Analysis-Key

VOICE_EMBEDDING_HOST=0.0.0.0
VOICE_EMBEDDING_PORT=8077
VOICE_EMBEDDING_BASE_URL=http://127.0.0.1:8077
VOICE_EMBEDDING_ENDPOINT=http://127.0.0.1:8077/embed
VOICE_EMBEDDING_HEALTH_URL=http://127.0.0.1:8077/health
VOICE_EMBEDDING_CONTAINER_ENDPOINT=http://voice-embedding:8077/embed

WINDOW_REFINE_HOST=0.0.0.0
WINDOW_REFINE_PORT=8078
WINDOW_REFINE_BASE_URL=http://127.0.0.1:8078
WINDOW_REFINE_ENDPOINT=http://127.0.0.1:8078/segment
WINDOW_REFINE_HEALTH_URL=http://127.0.0.1:8078/health
WINDOW_REFINE_CONTAINER_ENDPOINT=http://window-refine:8078/segment

VOICEANALYSIS_AUDIO_ROOT=runtime/audio
ECAPA_MODEL_DIR=runtime/models/ecapa/spkrec-ecapa-voxceleb
WINDOW_REFINE_MODEL_ROOT=runtime/models/pyannote
PYANNOTE_SEGMENTATION_MODEL_DIR=runtime/models/pyannote/segmentation-3.0
PYANNOTE_OSD_MODEL_DIR=runtime/models/pyannote/overlapped-speech-detection

# 当前没有可复制的 Hugging Face token。离线模型齐全时保持为空。
HUGGINGFACE_ACCESS_TOKEN=
WINDOW_REFINE_ALLOW_MODEL_DOWNLOAD=0
PYANNOTE_AUTH_TOKEN_ENV=HUGGINGFACE_ACCESS_TOKEN
PYANNOTE_OSD_ENABLED=0
WINDOW_REFINE_DEVICE=cpu

VOICEPRINT_BACKEND=speechbrain_ecapa
VOICEPRINT_SAMPLE_RATE=16000
VOICEPRINT_MIN_CLIP_MS=400
VOICEPRINT_MAX_CLIP_MS=30000
VOICEPRINT_EMBED_DIM=192
VOICEPRINT_MAX_REQUEST_BYTES=33554432
VOICEPRINT_QUEUE_REQUESTS=4
VOICEPRINT_QUEUE_BYTES=134217728
VOICEPRINT_BATCH_WINDOWS=16
VOICEPRINT_BATCH_AUDIO_SECONDS=60
VOICEPRINT_MICROBATCH_WAIT_MS=10
VOICEPRINT_TORCH_THREADS=4
VOICEPRINT_TORCH_INTEROP_THREADS=1

OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
OPENBLAS_NUM_THREADS=4
MALLOC_ARENA_MAX=2
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
